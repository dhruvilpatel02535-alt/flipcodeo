import { getCollection } from 'astro:content';
const photos = await getCollection('portfolio');
const sortedPhotos = photos.sort((a, b) => (a.data.order || 0) - (b.data.order || 0));

const heroEntries = await getCollection('hero');
const hero = heroEntries[0];

const aboutEntries = await getCollection('about');
const about = aboutEntries[0];

const servicesEntries = await getCollection('services');
const sortedServices = servicesEntries.sort((a, b) => (a.data.order || 0) - (b.data.order || 0));

const pricingEntries = await getCollection('pricing');
const sortedPricing = pricingEntries.sort((a, b) => (a.data.order || 0) - (b.data.order || 0));

const addonsEntries = await getCollection('addons');
const sortedAddons = addonsEntries.sort((a, b) => (a.data.order || 0) - (b.data.order || 0));

const processEntries = await getCollection('process');
const sortedProcess = processEntries.sort((a, b) => (a.data.order || 0) - (b.data.order || 0));

const whyEntries = await getCollection('why');
const sortedWhy = whyEntries.sort((a, b) => (a.data.order || 0) - (b.data.order || 0));

const faqEntries = await getCollection('faq');
const sortedFaq = faqEntries.sort((a, b) => (a.data.order || 0) - (b.data.order || 0));

const blogEntries = await getCollection('blog');
const sortedBlog = blogEntries.sort((a, b) => (a.data.order || 0) - (b.data.order || 0));

// Blog data ko JSON mein convert karo (JavaScript ke liye)
const blogDataObj = {};
sortedBlog.forEach(entry => {
  blogDataObj[entry.id] = {
    tag: entry.data.tag,
    title: entry.data.title,
    body: entry.data.body
  };
});

const contactEntries = await getCollection('contact');
const contactData = contactEntries[0];

const footerEntries = await getCollection('footer');
const footerData = footerEntries[0];

const domainInfoEntries = await getCollection('domainInfo');
const domainInfoData = domainInfoEntries[0];

const testimonialsEntries = await getCollection('testimonials');
const sortedTestimonials = testimonialsEntries.sort((a, b) => (a.data.order || 0) - (b.data.order || 0));

