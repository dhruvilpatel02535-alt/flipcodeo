        .contact-wrap { display: grid; grid-template-columns: 1fr 1.2fr; gap: 40px; background: #fff; border: 1px solid #eaeaea; padding: 45px 40px; box-shadow: 0 30px 70px rgba(0,0,0,0.05); max-width: 1100px; margin: 0 auto; }
