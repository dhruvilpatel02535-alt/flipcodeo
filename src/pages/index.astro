            border: 2px solid #d4af37;
        }
        .testimonial-author h4 {
            font-family: 'Playfair Display', serif;
            font-size: 1.05rem;
            font-weight: 700;
            color: #111;
            margin-bottom: 3px;
        }
        .testimonial-author p {
            font-size: 0.8rem;
            color: #888;
            margin-bottom: 3px;
        }
        .testimonial-date {
            font-size: 0.7rem;
            color: #aaa;
            text-transform: uppercase;
            letter-spacing: 1px;
        }
        .testimonial-screenshot {
            width: 100%;
            margin-top: 18px;
            border-radius: 8px;
            border: 1px solid #eaeaea;
            max-height: 200px;
            object-fit: contain;
        }

        /* ============ RESPONSIVE ============ */
        @media (max-width: 900px) {
            nav { padding: 20px 25px; }
            nav.scrolled { padding: 12px 25px; }
            .nav-links { display: none; position: absolute; top: 75px; left: 15px; right: 15px; background: rgba(255, 255, 255, 0.98); backdrop-filter: blur(20px); padding: 25px; flex-direction: column; gap: 15px; box-shadow: 0 20px 60px rgba(0, 0, 0, 0.15); border-radius: 20px; border: 1px solid rgba(212, 175, 55, 0.2); }
            .nav-links.open { display: flex; }
            .nav-links a { padding: 12px 20px; border-radius: 12px; width: 100%; text-align: center; }
