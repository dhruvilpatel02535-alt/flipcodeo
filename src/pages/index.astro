        .footer-logo-sub { font-size: 0.7rem; letter-spacing: 4px; text-transform: uppercase; color: #888; margin-top: 8px; font-family: 'Space Grotesk', sans-serif; font-style: normal; font-weight: 500; }
        .footer-links { display: flex; justify-content: center; gap: 35px; margin-bottom: 45px; flex-wrap: wrap; }
