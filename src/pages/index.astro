            document.getElementById('modalBody').innerHTML = article.body;
            const modal = document.getElementById('blogModal');
            modal.classList.add('active');
            document.body.style.overflow = 'hidden';
        }

        function closeBlog() {
            const modal = document.getElementById('blogModal');
            modal.classList.remove('active');
            document.body.style.overflow = '';
        }

        const blogModal = document.getElementById('blogModal');
        if (blogModal) {
            blogModal.addEventListener('click', function(e) {
                if (e.target === this) closeBlog();
            });
        }

        // ============ PORTFOLIO LIGHTBOX ============
        function openPortfolio(imgSrc, caption) {
            const lightbox = document.getElementById('portfolioLightbox');
            document.getElementById('portfolioLightboxImg').src = imgSrc;
            lightbox.classList.add('active');
            document.body.style.overflow = 'hidden';
        }

        function closePortfolio(event) {
            if (event && event.target.tagName === 'IMG') return;
            const lightbox = document.getElementById('portfolioLightbox');
            lightbox.classList.remove('active');
            document.body.style.overflow = '';
        }

        // ============ ESCAPE KEY ============
