<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Flipcodeo – Website Designer in India | Professional Website Design Services</title>
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <meta name="description" content="Flipcodeo is a professional website design company in India. We create responsive, SEO-friendly websites for small businesses, startups, and local shops.">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;0,900;1,400&family=Cormorant+Garamond:ital,wght@0,400;0,700;1,400&family=Space+Grotesk:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
        html { scroll-behavior: smooth; }
        body { font-family: 'Space Grotesk', sans-serif; background: #fafafa; color: #111; overflow-x: hidden; }

        /* ============ FLOATING PAPERS BACKGROUND ============ */
        .papers-bg { position: fixed; inset: 0; z-index: -2; overflow: hidden; pointer-events: none; }
        .paper { position: absolute; background: #ffffff; border: 1px solid rgba(0,0,0,0.08); box-shadow: 0 20px 60px rgba(0,0,0,0.08); border-radius: 2px; opacity: 0.8; animation: paperFloat 15s infinite ease-in-out; }
        .paper-1 { width: 350px; height: 450px; top: 10%; left: 5%; transform: rotate(-10deg); animation-delay: 0s; }
        .paper-2 { width: 300px; height: 400px; top: 20%; right: 8%; transform: rotate(8deg); animation-delay: 3s; }
        .paper-3 { width: 280px; height: 350px; bottom: 10%; left: 12%; transform: rotate(6deg); animation-delay: 6s; }
        .paper-4 { width: 250px; height: 320px; bottom: 15%; right: 15%; transform: rotate(-5deg); animation-delay: 9s; }
        @keyframes paperFloat { 0%, 100% { transform: translateY(0) rotate(-10deg); } 50% { transform: translateY(-20px) rotate(-10deg); } }

        /* ============ SPLASH SCREEN ============ */
        .splash-screen { position: fixed; inset: 0; z-index: 999999; background: #ffffff; display: flex; justify-content: center; align-items: center; opacity: 1; transition: opacity 0.6s ease; }
        .splash-logo { font-family: 'Cormorant Garamond', serif; font-style: italic; font-size: 4rem; font-weight: 700; color: #111; position: relative; filter: drop-shadow(0 0 15px rgba(212,175,55,0.4)); animation: splashLogoIn 1.5s ease forwards; }
        @keyframes splashLogoIn { 0% { opacity: 0; transform: scale(0.3); } 30% { opacity: 1; transform: scale(1.1); } 60% { opacity: 1; transform: scale(1); } 100% { opacity: 1; transform: scale(1); } }
        .splash-logo::after { content: ''; position: absolute; bottom: -10px; left: 0; width: 100%; height: 1px; background: linear-gradient(90deg, transparent, #d4af37, transparent); animation: splashLine 1.5s ease forwards; }
        @keyframes splashLine { 0% { transform: scaleX(0); } 100% { transform: scaleX(1); } }
        .splash-sub { font-size: 0.7rem; letter-spacing: 5px; text-transform: uppercase; color: #555; margin-top: 15px; text-align: center; font-family: 'Space Grotesk', sans-serif; font-weight: 500; opacity: 0; animation: splashSubIn 0.8s 0.8s forwards; }
        @keyframes splashSubIn { to { opacity: 1; } }

        /* ============ NAVBAR ============ */
        nav { position: fixed; top: 0; width: 100%; padding: 30px 40px; display: flex; justify-content: space-between; align-items: center; z-index: 1000; background: rgba(250,250,250,0.7); backdrop-filter: blur(15px); border-bottom: 1px solid transparent; transition: 0.4s; opacity: 0; transform: translateY(-20px); animation: navIn 1s 1.2s forwards; }
        @keyframes navIn { to { opacity: 1; transform: translateY(0); } }
        nav.scrolled { padding: 15px 40px; background: rgba(255,255,255,0.95); border-bottom: 1px solid #e0e0e0; }
        .logo { display: inline-flex; flex-direction: column; align-items: center; text-decoration: none; font-family: 'Cormorant Garamond', serif; font-style: italic; font-size: 1.8rem; font-weight: 700; color: #111; line-height: 1; position: relative; filter: drop-shadow(0 0 5px rgba(212,175,55,0.3)); animation: logoGlow 3s infinite; }
        @keyframes logoGlow { 0%, 100% { filter: drop-shadow(0 0 5px rgba(212,175,55,0.3)); } 50% { filter: drop-shadow(0 0 15px rgba(212,175,55,0.6)); } }
        .logo::after { content: ''; position: absolute; bottom: -5px; left: 0; width: 100%; height: 1px; background: linear-gradient(90deg, transparent, #d4af37, transparent); }
        .logo-sub { font-size: 0.45rem; letter-spacing: 3px; text-transform: uppercase; color: #888; margin-top: 3px; font-family: 'Space Grotesk', sans-serif; font-style: normal; font-weight: 500; }
        .nav-links { display: flex; gap: 30px; list-style: none; align-items: center; }
        .nav-links a { text-decoration: none; color: #333; font-size: 0.8rem; font-weight: 500; text-transform: uppercase; letter-spacing: 2px; position: relative; transition: 0.3s; cursor: pointer; }
        .nav-links a::after { content: ''; position: absolute; bottom: -5px; left: 0; width: 0; height: 1px; background: #111; transition: 0.4s; }
        .nav-links a:hover { color: #111; }
        .nav-links a:hover::after { width: 100%; }

        /* ============ HAMBURGER ============ */
        .hamburger { display: none; flex-direction: column; gap: 5px; cursor: pointer; background: rgba(255, 255, 255, 0.8); border: 1px solid rgba(212, 175, 55, 0.3); padding: 12px 10px; border-radius: 12px; transition: all 0.4s; }
        .hamburger:hover { border-color: #d4af37; transform: translateY(-2px); }
        .hamburger span { width: 26px; height: 2px; background: linear-gradient(90deg, #111, #333); border-radius: 2px; transition: all 0.4s; }
        .hamburger span:nth-child(1) { width: 26px; }
        .hamburger span:nth-child(2) { width: 20px; background: linear-gradient(90deg, #d4af37, #b8942a); }
        .hamburger span:nth-child(3) { width: 26px; }
        .hamburger.active span:nth-child(1) { transform: rotate(45deg) translate(5px, 5px); background: #d4af37; }
        .hamburger.active span:nth-child(2) { opacity: 0; transform: translateX(-10px); }
        .hamburger.active span:nth-child(3) { transform: rotate(-45deg) translate(5px, -5px); background: #d4af37; }

        /* ============ HERO ============ */
        .hero { min-height: 100vh; display: flex; flex-direction: column; justify-content: center; align-items: center; text-align: center; padding: 160px 20px 80px; position: relative; }
        .hero-tagline { font-size: 0.7rem; letter-spacing: 6px; text-transform: uppercase; color: #d4af37; font-weight: 600; margin-bottom: 20px; opacity: 0; animation: fadeUp 1s 1.8s forwards; }
        @keyframes fadeUp { to { opacity: 1; transform: translateY(0); } }
        .hero-title { font-family: 'Cormorant Garamond', serif; font-style: italic; font-size: clamp(3.5rem, 12vw, 8rem); font-weight: 700; line-height: 1; margin-bottom: 25px; display: flex; flex-wrap: wrap; justify-content: center; }
        .letter { display: inline-block; opacity: 0; transform: translateY(60px) rotateX(80deg); animation: letterFlip 1.2s forwards, letterGlow 3s ease-in-out infinite; transform-origin: bottom; background: linear-gradient(135deg, #111 0%, #333 50%, #111 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
        @keyframes letterFlip { 0% { opacity: 0; transform: translateY(60px) rotateX(80deg); } 100% { opacity: 1; transform: translateY(0) rotateX(0); } }
        @keyframes letterGlow { 0%, 100% { filter: drop-shadow(0 0 15px rgba(212, 175, 55, 0.3)); } 50% { filter: drop-shadow(0 0 25px rgba(212, 175, 55, 0.5)); } }
        .hero-divider { width: 60px; height: 1px; background: linear-gradient(90deg, transparent, #d4af37, transparent); margin: 0 auto 25px; opacity: 0; animation: fadeUp 1s 1.9s forwards; }
        .hero-subtitle { font-family: 'Playfair Display', serif; font-size: 1.2rem; color: #111; letter-spacing: 1px; margin-bottom: 25px; opacity: 0; animation: fadeUp 1s 2s forwards; max-width: 600px; }
        .hero-desc { font-size: 1.05rem; color: #666; max-width: 580px; margin: 0 auto 30px; line-height: 1.9; font-weight: 300; opacity: 0; transform: translateY(20px); animation: fadeUp 1s 2.2s forwards; }
        .hero-desc strong { color: #111; font-weight: 600; }
        .hero-price { display: inline-block; font-family: 'Playfair Display', serif; font-size: 1rem; font-weight: 700; color: #d4af37; padding: 12px 35px; border: 1px solid rgba(212, 175, 55, 0.5); border-radius: 50px; background: rgba(212, 175, 55, 0.05); margin-bottom: 35px; opacity: 0; transform: translateY(20px); animation: fadeUp 1s 2.3s forwards; }
        .hero-btns { display: flex; gap: 20px; flex-wrap: wrap; justify-content: center; opacity: 0; transform: translateY(20px); animation: fadeUp 1s 2.5s forwards; }
        .magnetic-btn { background: #111; color: #fff; padding: 18px 55px; border-radius: 50px; font-size: 0.85rem; font-weight: 600; letter-spacing: 3px; text-transform: uppercase; cursor: pointer; border: none; transition: all 0.3s; text-decoration: none; display: inline-block; font-family: 'Space Grotesk', sans-serif; }
        .magnetic-btn:hover { background: #000; transform: translateY(-3px) scale(1.02); box-shadow: 0 20px 50px rgba(0,0,0,0.2); }

        /* ============ SECTION COMMON ============ */
        section { padding: 100px 40px; max-width: 1300px; margin: 0 auto; }
        .section-tag { font-size: 0.75rem; letter-spacing: 6px; text-transform: uppercase; color: #999; text-align: center; margin-bottom: 18px; }
        .section-title { font-family: 'Playfair Display', serif; font-size: 3rem; font-weight: 900; text-align: center; margin-bottom: 20px; line-height: 1.1; }
        .section-sub { font-size: 1rem; color: #777; text-align: center; max-width: 700px; margin: 0 auto 60px; line-height: 1.8; }

        .reveal { opacity: 0; transform: translateY(40px); transition: all 1s cubic-bezier(0.25, 1, 0.5, 1); }
        .reveal.active { opacity: 1; transform: translateY(0); }
        .stagger > * { opacity: 0; transform: translateY(30px); transition: all 0.9s cubic-bezier(0.25, 1, 0.5, 1); }
        .stagger.active > * { opacity: 1; transform: translateY(0); }
        .stagger.active > *:nth-child(1) { transition-delay: 0.1s; }
        .stagger.active > *:nth-child(2) { transition-delay: 0.2s; }
        .stagger.active > *:nth-child(3) { transition-delay: 0.3s; }
        .stagger.active > *:nth-child(4) { transition-delay: 0.4s; }
        .stagger.active > *:nth-child(5) { transition-delay: 0.5s; }
        .stagger.active > *:nth-child(6) { transition-delay: 0.6s; }

        /* ============ SERVICES ============ */
        .services-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 25px; }
        .service-card { background: #fff; border: 1px solid #eaeaea; padding: 45px 30px; transition: 0.4s; position: relative; overflow: hidden; }
        .service-card::before { content: ''; position: absolute; bottom: 0; left: 0; width: 100%; height: 3px; background: #111; transform: scaleX(0); transform-origin: left; transition: 0.5s; }
        .service-card:hover::before { transform: scaleX(1); }
        .service-card:hover { transform: translateY(-8px); box-shadow: 0 20px 60px rgba(0,0,0,0.06); }
        .service-icon { font-size: 2.5rem; margin-bottom: 25px; display: inline-block; transition: 0.3s; }
        .service-card:hover .service-icon { transform: scale(1.2) rotate(10deg); }
        .service-card h3 { font-family: 'Playfair Display', serif; font-size: 1.4rem; font-weight: 700; margin-bottom: 15px; }
        .service-card p { color: #777; font-size: 0.9rem; line-height: 1.8; text-align: justify; hyphens: auto; }
        .service-card p strong { color: #111; }

        /* ============ PRICING ============ */
        .pricing-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 25px; }
        .pricing-card { background: #fff; border: 1px solid #eaeaea; padding: 35px 30px; text-align: center; transition: 0.4s; position: relative; }
        .pricing-card:hover { transform: translateY(-8px); box-shadow: 0 20px 60px rgba(0,0,0,0.08); }
        .pricing-card h3 { font-family: 'Playfair Display', serif; font-size: 1.6rem; font-weight: 700; margin-bottom: 15px; }
        .pricing-card .price { font-size: 2.8rem; font-weight: 900; color: #111; margin-bottom: 10px; }
        .pricing-card .price-note { font-size: 0.75rem; color: #999; margin-bottom: 20px; }
        .pricing-card ul { list-style: none; margin-bottom: 30px; text-align: left; }
        .pricing-card ul li { padding: 8px 0; color: #555; font-size: 0.9rem; }
        .pricing-card ul li::before { content: '✓ '; color: #d4af37; font-weight: 700; }
        .pricing-card ul li.muted { color: #aaa; }
        .pricing-card ul li.muted::before { content: '✗ '; color: #ddd; }
        .pricing-card .btn { background: #111; color: #fff; padding: 12px 30px; border: none; border-radius: 50px; cursor: pointer; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 2px; font-family: 'Space Grotesk', sans-serif; }
        .pricing-card .btn:hover { background: #333; }
        .pricing-card.popular { border: 2px solid #d4af37; }
        .pricing-card.popular::before { content: 'Most Popular'; position: absolute; top: -15px; left: 50%; transform: translateX(-50%); background: #d4af37; color: #111; padding: 5px 20px; border-radius: 50px; font-size: 0.75rem; font-weight: 700; }

        /* ============ ADD-ONS ============ */
        .addons-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px; max-width: 1000px; margin: 0 auto; }
        .addon-card { background: #fff; border: 1px solid #eaeaea; padding: 20px 22px; display: flex; justify-content: space-between; align-items: center; transition: 0.3s; }
        .addon-card:hover { border-color: #d4af37; transform: translateY(-3px); box-shadow: 0 10px 30px rgba(0,0,0,0.05); }
        .addon-card .addon-name { font-weight: 500; color: #111; font-size: 0.95rem; }
        .addon-card .addon-note { display: block; font-weight: 400; color: #999; font-size: 0.75rem; margin-top: 4px; }
        .addon-card .addon-price { font-weight: 700; color: #d4af37; font-size: 1rem; white-space: nowrap; margin-left: 15px; }

        .domain-info { max-width: 800px; margin: 40px auto 0; background: #fff; border: 1px solid #eaeaea; border-left: 3px solid #d4af37; padding: 25px 30px; }
        .domain-info h4 { font-family: 'Playfair Display', serif; font-size: 1.2rem; margin-bottom: 15px; color: #111; }
        .domain-info p { color: #666; font-size: 0.9rem; line-height: 1.8; margin-bottom: 12px; }
        .domain-info table { width: 100%; border-collapse: collapse; margin-top: 15px; }
        .domain-info table td { padding: 10px 0; font-size: 0.9rem; color: #555; border-bottom: 1px solid #f0f0f0; }
        .domain-info table td:last-child { text-align: right; font-weight: 600; color: #111; }
        .domain-info table tr:last-child td { border-bottom: none; }

        /* ============ PROCESS ============ */
        .process-steps { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 25px; }
        .process-step { text-align: center; padding: 35px 25px; background: #fff; border: 1px solid #eaeaea; transition: 0.4s; }
        .process-step:hover { transform: translateY(-5px); box-shadow: 0 15px 40px rgba(0,0,0,0.05); }
        .process-step .step-number { font-size: 2.8rem; font-weight: 900; color: #d4af37; font-family: 'Playfair Display', serif; margin-bottom: 15px; }
        .process-step h4 { font-family: 'Playfair Display', serif; font-size: 1.2rem; margin-bottom: 10px; }
        .process-step p { color: #777; font-size: 0.9rem; text-align: justify; hyphens: auto; }

        /* ============ ABOUT ============ */
        .about-section { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; align-items: center; }
        .about-img { width: 100%; height: 380px; object-fit: cover; border-radius: 10px; }
        .about-text h3 { font-family: 'Playfair Display', serif; font-size: 2rem; margin-bottom: 15px; line-height: 1.2; }
        .about-text p { color: #555; line-height: 1.8; margin-bottom: 15px; font-size: 0.95rem; text-align: justify; hyphens: auto; }
        .about-text p strong { color: #111; }
        .about-text .skills { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 15px; }
        .about-text .skills span { background: #f0f0f0; padding: 6px 14px; border-radius: 20px; font-size: 0.75rem; font-weight: 600; }

        /* ============ PORTFOLIO ============ */
        .portfolio-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 25px; }
        .portfolio-card { background: #fff; border: 1px solid #eaeaea; overflow: hidden; cursor: pointer; transition: 0.4s; }
        .portfolio-card:hover { transform: translateY(-8px); box-shadow: 0 25px 60px rgba(0,0,0,0.12); border-color: #d4af37; }
        .portfolio-img-wrap { width: 100%; height: 240px; overflow: hidden; position: relative; background: #f0f0f0; }
        .portfolio-img-wrap img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s; display: block; }
        .portfolio-card:hover .portfolio-img-wrap img { transform: scale(1.1); }
        .portfolio-overlay { position: absolute; inset: 0; background: linear-gradient(to top, rgba(0,0,0,0.6), transparent 60%); opacity: 0; transition: opacity 0.4s; display: flex; align-items: flex-end; padding: 20px; }
        .portfolio-card:hover .portfolio-overlay { opacity: 1; }
        .portfolio-overlay span { color: #fff; font-size: 0.75rem; letter-spacing: 3px; text-transform: uppercase; font-weight: 600; }
        .portfolio-info { padding: 20px 22px; border-top: 1px solid #f0f0f0; }
        .portfolio-info h4 { font-family: 'Playfair Display', serif; font-size: 1.15rem; font-weight: 700; margin-bottom: 5px; }
        .portfolio-info p { font-size: 0.8rem; color: #999; text-transform: uppercase; letter-spacing: 2px; }

        .portfolio-lightbox { position: fixed; inset: 0; z-index: 99999; background: rgba(0,0,0,0.92); backdrop-filter: blur(10px); display: flex; justify-content: center; align-items: center; padding: 30px; opacity: 0; visibility: hidden; transition: opacity 0.4s, visibility 0.4s; }
        .portfolio-lightbox.active { opacity: 1; visibility: visible; }
        .portfolio-lightbox img { max-width: 90%; max-height: 85vh; object-fit: contain; border-radius: 8px; }
        .portfolio-lightbox-close { position: absolute; top: 25px; right: 30px; background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.3); color: #fff; width: 45px; height: 45px; border-radius: 50%; font-size: 1.5rem; cursor: pointer; }
        .portfolio-lightbox-close:hover { background: #d4af37; }

        /* ============ BLOG ============ */
        .blog-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 25px; }
        .blog-card { background: #fff; border: 1px solid #eaeaea; padding: 30px 25px; transition: 0.4s; }
        .blog-card:hover { transform: translateY(-8px); box-shadow: 0 20px 60px rgba(0,0,0,0.08); border-color: #d4af37; }
        .blog-tag { display: inline-block; background: #fff8e7; color: #d4af37; padding: 5px 15px; border-radius: 20px; font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 15px; }
        .blog-card h3 { font-family: 'Playfair Display', serif; font-size: 1.3rem; font-weight: 700; margin-bottom: 12px; line-height: 1.3; }
        .blog-card p { color: #777; font-size: 0.9rem; line-height: 1.7; margin-bottom: 20px; text-align: justify; hyphens: auto; }
        .blog-read { color: #d4af37; font-size: 0.85rem; font-weight: 600; cursor: pointer; }
        .blog-read:hover { color: #b8942a; }

        .blog-modal { position: fixed; inset: 0; z-index: 99999; background: rgba(0,0,0,0.6); backdrop-filter: blur(8px); display: flex; justify-content: center; align-items: center; padding: 20px; opacity: 0; visibility: hidden; transition: 0.4s; }
        .blog-modal.active { opacity: 1; visibility: visible; }
        .blog-modal-content { background: #fff; max-width: 800px; width: 100%; max-height: 85vh; overflow-y: auto; border-radius: 16px; padding: 45px 40px; position: relative; }
        .blog-modal-close { position: absolute; top: 15px; right: 20px; background: #f5f5f5; border: none; width: 40px; height: 40px; border-radius: 50%; font-size: 1.4rem; cursor: pointer; }
        .blog-modal-close:hover { background: #d4af37; color: #fff; }
        .blog-modal-content h2 { font-family: 'Playfair Display', serif; font-size: 2rem; font-weight: 900; line-height: 1.25; margin-bottom: 20px; }
        .blog-modal-content .blog-body { color: #555; font-size: 1rem; line-height: 1.9; }
        .blog-modal-content .blog-body p { margin-bottom: 18px; text-align: justify; hyphens: auto; }
        .blog-modal-content .blog-body strong { color: #111; }
        .blog-modal-content .blog-body h3 { font-family: 'Playfair Display', serif; font-size: 1.3rem; margin: 28px 0 14px; }
        .blog-modal-content .blog-body ul { margin: 0 0 18px 22px; }
        .blog-modal-content .blog-body ul li { margin-bottom: 8px; }

